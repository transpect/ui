name: TranspectUITest
services:
  transpectui:
    image: transpectui:latest
    container_name: TranspectUI
    volumes:
      - ../src/transpectui:/opt/basex/webapp/transpectui
      - ../src/repo:/opt/basex/install/transpectui
      - ../src/static:/opt/basex/webapp/static
      - ../scripts:/opt/scripts
    ports:
     - "8083:8000"
    logging:
        driver: "json-file"
        options:
            max-size: "5m"
  worker1:
    image: transpectui_brepols:266
    container_name: Gandalf
    volumes:
      - ../data/gandalf:/opt/data
      - ../scripts:/opt/scripts
    logging:
        driver: "json-file"
        options:
            max-size: "5m"
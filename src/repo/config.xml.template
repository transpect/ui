<?xml version="1.0" encoding="UTF-8"?>
<configurations>
  <configuration>
    <data-dir-base>/opt/data</data-dir-base>
    <base-url></base-url>
    <queue max="3"/>
    <api>
      <allow-basic-auth>false</allow-basic-auth>
      <allow-bearer-auth>true</allow-bearer-auth>
    </api>
    <controller activated="true">
      <worker id="gandalf" name="Gandalf">
        <base-url>http://gandalf:8000</base-url>
      </worker>
    </controller>
  </configuration>
</configurations>
